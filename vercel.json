{
  "builds": [
    { "src": "Frontend/**/*", "use": "@vercel/static" },
    { "src": "Backend/**/*", "use": "@vercel/static" },
    { "src": "assets/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/Backend/(.*)", "dest": "/Backend/$1" },
    { "src": "/(.*)", "dest": "/Frontend/$1" }
  ]
}
